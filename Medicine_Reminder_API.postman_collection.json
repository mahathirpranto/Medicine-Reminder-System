{
  "info": {
    "_postman_id": "b7890a12-89cd-4ef0-9123-medreminder02",
    "name": "Medicine Reminder System API (Complete Suite)",
    "description": "Complete Postman API Collection for Medicine Reminder System featuring JWT Authentication, Session Management, Multi-tenant Medicine CRUD, and Dose Tracking.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & Sessions",
      "item": [
        {
          "name": "1.1 User Signup (Register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Mahathir Pranto\",\n  \"email\": \"patient_demo@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "signup"]
            },
            "description": "Registers a new user, hashes password with bcrypt, and returns access and refresh tokens."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "}",
                  "if (jsonData.refresh_token) {",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
                  "}",
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"crud_test_user@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Validates credentials and automatically saves the access_token and refresh_token into collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "}",
                  "if (jsonData.refresh_token) {",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
                  "}",
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Protected endpoint: returns the authenticated user's profile."
          }
        },
        {
          "name": "1.4 Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Renews expired 15-minute access token by validating the refresh token hash in user_sessions table."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "}",
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.5 Logout (Revoke Session)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Revokes the active refresh token in the database, preventing reuse."
          }
        }
      ]
    },
    {
      "name": "2. Medicine CRUD Operations",
      "item": [
        {
          "name": "2.1 CREATE: Add Medicine",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicine_name\": \"Amoxicillin\",\n  \"dosage\": \"500 mg\",\n  \"frequency\": \"Three times daily\",\n  \"reminder_time\": \"08:00 AM, 02:00 PM, 08:00 PM\",\n  \"start_date\": \"2026-11-20\",\n  \"end_date\": \"2026-11-30\",\n  \"status\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/medicines",
              "host": ["{{base_url}}"],
              "path": ["api", "medicines"]
            },
            "description": "Creates a new medicine linked to the authenticated user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('medicine_id', jsonData.id);",
                  "}",
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 READ LIST: Get All Medicines",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/medicines?status=true",
              "host": ["{{base_url}}"],
              "path": ["api", "medicines"],
              "query": [
                {
                  "key": "status",
                  "value": "true"
                }
              ]
            },
            "description": "Lists all medicines for the authenticated user."
          }
        },
        {
          "name": "2.3 READ SINGLE: Get Medicine by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/medicines/{{medicine_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "medicines", "{{medicine_id}}"]
            },
            "description": "Retrieves details of a single medicine owned by the user."
          }
        },
        {
          "name": "2.4 UPDATE: Edit Medicine",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dosage\": \"650 mg\",\n  \"status\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/medicines/{{medicine_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "medicines", "{{medicine_id}}"]
            },
            "description": "Updates medicine dosage and status."
          }
        },
        {
          "name": "2.5 DELETE: Remove Medicine",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/medicines/{{medicine_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "medicines", "{{medicine_id}}"]
            },
            "description": "Deletes medicine record by ID."
          }
        }
      ]
    },
    {
      "name": "3. Dose Tracking & Reminders",
      "item": [
        {
          "name": "3.1 Get Today's Schedule & Dose Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/medicines/schedule/today",
              "host": ["{{base_url}}"],
              "path": ["api", "medicines", "schedule", "today"]
            },
            "description": "Returns today's active medicines with reminder times and taken status."
          }
        },
        {
          "name": "3.2 Record Dose as Taken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dose_time\": \"08:00 AM\",\n  \"status\": \"taken\",\n  \"notes\": \"Taken after breakfast\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/medicines/{{medicine_id}}/doses",
              "host": ["{{base_url}}"],
              "path": ["api", "medicines", "{{medicine_id}}", "doses"]
            },
            "description": "Records that the patient took their scheduled dose."
          }
        },
        {
          "name": "3.3 Get Medicine Dose History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/medicines/{{medicine_id}}/doses?limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "medicines", "{{medicine_id}}", "doses"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Retrieves intake logs for a specific medicine."
          }
        },
        {
          "name": "3.4 Get User Global Dose History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/medicines/doses/history?limit=30",
              "host": ["{{base_url}}"],
              "path": ["api", "medicines", "doses", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "30"
                }
              ]
            },
            "description": "Retrieves recent dose intake logs across all medicines for the user."
          }
        }
      ]
    },
    {
      "name": "4. Role-Based Access Control (RBAC)",
      "item": [
        {
          "name": "4.1 Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates as the seeded System Administrator and extracts admin_token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('admin_token', jsonData.access_token);",
                  "}",
                  "pm.test('Admin Login Successful (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.user.role).to.eql('admin');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4.2 Get System Statistics (Admin Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "stats"]
            },
            "description": "Returns system-wide stats: users, patients, admins, medications, and doses logged."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin Stats Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('total_users');",
                  "    pm.expect(data).to.have.property('total_patients');",
                  "    pm.expect(data).to.have.property('total_admins');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4.3 Get User Directory & Roles (Admin Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/users",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users"]
            },
            "description": "Lists all registered users along with their role and medicine counts."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('List Users Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.expect(Array.isArray(data)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4.4 Verify Patient Is Forbidden from Admin Stats (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "stats"]
            },
            "description": "Tests RBAC enforcement: patient access_token attempting admin endpoint is rejected with 403 Forbidden."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('RBAC Forbidden Status 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4.5 Vatista Login (Secondary Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vatista@example.com\",\n  \"password\": \"VatistaPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates as Vatista (secondary administrator) and extracts vatista_token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('vatista_token', jsonData.access_token);",
                  "}",
                  "pm.test('Vatista Login Successful (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.user.role).to.eql('admin');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4.6 Verify Vatista Cannot Modify System Administrator (403)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vatista_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"patient\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/users/1/role",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users", "1", "role"]
            },
            "description": "Verifies that Vatista (secondary admin) is blocked from modifying or demoting the System Administrator."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vatista Blocked from Modifying Main Admin (403)', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "vatista_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "medicine_id",
      "value": "1"
    }
  ]
}
